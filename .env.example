APP_NAME="Ottodot Trial Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ottodot
DB_USERNAME=ottodot
DB_PASSWORD=secret

# Seat claiming: hold (booking reserves the seat for BOOKING_HOLD_MINUTES) | first_to_pay (refund late payers)
BOOKING_MODE=hold
BOOKING_HOLD_MINUTES=1
